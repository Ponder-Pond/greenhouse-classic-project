#new:Script $Script_Init_SuperFly {
	Call BindIdle ( .Actor:Self $Script_Idle_SuperFly )
	Call BindHandleEvent ( .Actor:Self $Script_HandleEvent_SuperFly )
	Call BindTakeTurn ( .Actor:Self $Script_TakeTurn_SuperFly )
	Call SetActorVar ( .Actor:Self .SuperFlyActorVar:TurnCount .SuperFlyActorValue:TurnOne )
	Return
	End
}

#new:Script $Script_Idle_SuperFly {
	Return
	End
}

#new:Script $Script_ReturnHome_SuperFly {
	Call ResetAllActorSounds ( .Actor:Self )
	Call SetGoalToHome ( .Actor:Self )
	Call FlyToGoal ( .Actor:Self 15` 0` .Easing:Linear )
	Call SetAnimation ( .Actor:Self .SuperFlyPart:Main .Anim:SuperFly_Idle )
	Return
	End
}

#new:Script $Script_HandleEvent_SuperFly {
	Call UseIdleAnimation ( .Actor:Self .False )
	Call EnableIdleScript ( .Actor:Self .False )
	Call GetLastEvent ( .Actor:Self *Var0 )
	Switch *Var0
		CaseOR == .Event:HitCombo % 9
		CaseOR == .Event:Hit % A
			SetConst *Var0 .SuperFlyPart:Main
			SetConst *Var1 .Anim:SuperFly_Idle % Hurt
			ExecWait DoNormalHit
		EndCaseGroup
		Case == .Event:BurnHit % E
			SetConst *Var0 .SuperFlyPart:Main
			SetConst *Var1 .Anim:SuperFly_Idle % BurnHurt
			SetConst *Var2 .Anim:SuperFly_Idle % BurnStill
			ExecWait DoBurnHit
		Case == .Event:BurnDeath % 24
			SetConst *Var0 .SuperFlyPart:Main
			SetConst *Var1 .Anim:SuperFly_Idle % BurnHurt
			SetConst *Var2 .Anim:SuperFly_Idle % BurnStill
			ExecWait DoBurnHit
			SetConst *Var0 .SuperFlyPart:Main
			SetConst *Var1 .Anim:SuperFly_Idle % BurnStill
			ExecWait DoDeath
			Return
		Case == .Event:ShockHit % 2F
			SetConst *Var0 .SuperFlyPart:Main
			SetConst *Var1 .Anim:SuperFly_Idle % Hurt?
			ExecWait DoShockHit
			SetConst *Var0 .SuperFlyPart:Main
			SetConst *Var1 .Anim:SuperFly_Idle % Hurt
			ExecWait DoJumpBack
			Call SetAnimation ( .Actor:Self .SuperFlyPart:Main .Anim:SuperFly_Idle ) % Jump???
			ExecWait $Script_ReturnHome_SuperFly
		Case == .Event:ShockDeath % 26
			SetConst *Var0 .SuperFlyPart:Main
			SetConst *Var1 .Anim:SuperFly_Idle % Hurt?
			ExecWait DoShockHit
			SetConst *Var0 .SuperFlyPart:Main
			SetConst *Var1 .Anim:SuperFly_Idle % Death
			ExecWait DoDeath
			Return
		Case == .Event:StarBeam % 13
		CaseOR == 00000017 % 17
		CaseOR == .Event:Immune % 19
		CaseOR == .Event:AirLiftFailed % 1F
			SetConst *Var0 .SuperFlyPart:Main
			SetConst *Var1 .Anim:SuperFly_Idle
			ExecWait DoImmune
		EndCaseGroup
		Case == .Event:Death % 20
			SetConst *Var0 .SuperFlyPart:Main
			SetConst *Var1 .Anim:SuperFly_Idle % Hurt
			ExecWait DoNormalHit
			Wait 10`
			SetConst *Var0 .SuperFlyPart:Main
			SetConst *Var1 .Anim:SuperFly_Idle % Death
			ExecWait DoDeath
			Return
		Case == .Event:RecoverStatus % 31
			SetConst *Var0 .SuperFlyPart:Main
			SetConst *Var1 .Anim:SuperFly_Idle
			ExecWait DoRecover
		Default
	EndSwitch
	Call EnableIdleScript ( .Actor:Self .True )
	Call UseIdleAnimation ( .Actor:Self .True )
	Return
	End
}

#new:Script $Script_TakeTurn_SuperFly {
	Call UseIdleAnimation ( .Actor:Self .False )
	Call EnableIdleScript ( .Actor:Self .False )
	Call GetActorVar ( .Actor:Self .SuperFlyActorVar:TurnCount *Var0 )
	Switch *Var0
	Case == .SuperFlyActorValue:TurnOne
        Call GetStatusFlags ( .Actor:Self *Var0 )
        If *Var0 & ~Flags:StatusFlags:Sleep|Frozen|Fear|Paralyze|Dizzy|Stone|Stop % 35D000
            Return
        EndIf
		Call UseBattleCamPreset ( 0000000D ) % BTL_CAM_ACTOR_CLOSE
		Call BattleCamTargetActor ( .Actor:Self )
		Call 8024ECF8 ( FFFFFFFF 00000001 00000000 ) % SetBattleCamTargetingModes
		Call SetBattleCamZoom ( 250` )
		Call SetBattleCamOffsetZ ( 35` )
		Call MoveBattleCamOver ( 40` )
		Call PlaySoundAtActor ( .Actor:Self .Sound:PowerUp )
		Call SetAnimation ( .Actor:Self .SuperFlyPart:Main .Anim:SuperFly_Attack )
        Call SetIdleAnimations ( .Actor:Self .SuperFlyPart:Main $IdleAnimations_Attack_SuperFly )
		Wait 30`
		Call UseBattleCamPreset ( 00000002 ) % BTL_CAM_DEFAULT
		Call MoveBattleCamOver ( 30` )
		Wait 30`
		Call SetActorVar ( .Actor:Self .SuperFlyActorVar:TurnCount .SuperFlyActorValue:TurnTwo )
	Case == .SuperFlyActorValue:TurnTwo
        Call GetStatusFlags ( .Actor:Self *Var0 )
        If *Var0 & ~Flags:StatusFlags:Sleep|Frozen|Fear|Paralyze|Dizzy|Stone|Stop % 35D000
            Return
        EndIf
		ExecWait $Script_Attack_QuadShot_SuperFly
	EndSwitch

	Call EnableIdleScript ( .Actor:Self .True )
	Call UseIdleAnimation ( .Actor:Self .True )
	Return
	End
}

%%%%% & WIP Scripts & %%%%%

#new:Script $Script_Attack_QuadShot_SuperFly {
	Call UseIdleAnimation ( .Actor:Self .False )
	Call EnableIdleScript ( .Actor:Self .False )
    Call UseBattleCamPreset ( 0000000D ) % BTL_CAM_ACTOR_CLOSE
    Call BattleCamTargetActor ( .Actor:Self )
    Call 8024ECF8 ( FFFFFFFF 00000001 00000000 ) % SetBattleCamTargetingModes
    Call SetBattleCamZoom ( 300` )
    Call SetBattleCamOffsetZ ( 25` ) % SetBattleCamOffsetY
    Call MoveBattleCamOver ( 12` )
	Wait 12`
	Call SetTargetActor ( .Actor:Self .Actor:Player )
	Call SetGoalToTarget ( .Actor:Self )
	Call SetAnimation ( .Actor:Self .SuperFlyPart:Main .Anim:SuperFly_Attack ) % Shot Prepare
	Wait 10`
	Call SetAnimation ( .Actor:Self .SuperFlyPart:Main .Anim:SuperFly_Attack ) % Shot End
	Call SetAnimation ( .Actor:Self .SuperFlyPart:BigShot .Anim:SmallFly_Idle )
  	Call GetActorPos ( .Actor:Self *Var0 *Var1 *Var2 )
	% Add *Var1 50`
  	Add *Var2 4`
  	Call SetPartPos ( .Actor:Self .SuperFlyPart:BigShot *Var0 *Var1 *Var2 )
	Call SetPartScale ( .Actor:Self .SuperFlyPart:BigShot *Fixed[2.0] *Fixed[2.0] *Fixed[1.0] )
	Call SetPartScale ( .Actor:Self .SuperFlyPart:QuadShot1 *Fixed[1.0] *Fixed[1.0] *Fixed[1.0] )
	Call SetPartScale ( .Actor:Self .SuperFlyPart:QuadShot2 *Fixed[1.0] *Fixed[1.0] *Fixed[1.0] )
	Call SetPartScale ( .Actor:Self .SuperFlyPart:QuadShot3 *Fixed[1.0] *Fixed[1.0] *Fixed[1.0] )
	Call SetPartScale ( .Actor:Self .SuperFlyPart:QuadShot4 *Fixed[1.0] *Fixed[1.0] *Fixed[1.0] )
	Call EnemyTestTarget ( .Actor:Self *Var0 0 0 0 0 )
	Switch *Var0
	CaseOR == .HitResult:Miss
	CaseOR == .HitResult:Lucky
		Call SetPartFlagBits ( .Actor:Self .SuperFlyPart:BigShot 00000001 .False )
		Call GetActorPos ( .Actor:Player *Var0 *Var1 *Var2 )
		Add *Var1 -5`
		Add *Var2 4`
		Call SetGoalPos ( .Actor:Self *Var0 *Var1 *Var2 )
		Wait 12`
		Call SetAnimation ( .Actor:Self .SuperFlyPart:Main .Anim:SuperFly_Attack ) % Idle
		Call UseBattleCamPreset ( 0000003F )
		Call BattleCamTargetActor ( .Actor:Self )
		Call 8024ECF8 ( FFFFFFFF 00000001 00000000 ) % SetBattleCamTargetingModes
		Call MoveBattleCamOver ( 24` )
		Wait 24`
		Call FlyPartTo ( .Actor:Self .SuperFlyPart:BigShot *Var0 *Var1 *Var2 24` 0` .Easing:Linear )
		Call SetPartFlagBits ( .Actor:Self .SuperFlyPart:BigShot 00000001 .True )
		Call SetGoalToTarget ( .Actor:Self )
		If *Var0 == .HitResult:Lucky
			Call EnemyTestTarget ( .Actor:Self *Var0 ~Flags:DamageType:TriggerLucky 00000000 00000000 00000000 )
		EndIf
		Goto ReturnHome
	EndSwitch
	Call SetPartFlagBits ( .Actor:Self .SuperFlyPart:BigShot 00000001 .False )
	Call GetActorPos ( .Actor:Player *Var0 *Var1 *Var2 )
	Add *Var1 -5`
	Add *Var2 4`
	Wait 12`
	Call SetAnimation ( .Actor:Self .SuperFlyPart:Main .Anim:SuperFly_Attack ) % Idle
	Call UseBattleCamPreset ( 0000003F )
	Call BattleCamTargetActor ( .Actor:Self )
	Call 8024ECF8 ( FFFFFFFF 00000001 00000000 ) % SetBattleCamTargetingModes
    Call MoveBattleCamOver ( 24` )
	Wait 24`
  	Call FlyPartTo ( .Actor:Self .SuperFlyPart:BigShot *Var0 *Var1 *Var2 24` 0` .Easing:Linear )
	Call SetGoalToTarget ( .Actor:Self )
	Call StartRumble ( 0000000B )
	Thread
		Call ShakeCam ( .Cam:Battle 0` 2` *Fixed[0.75] )
		Call ShakeCam ( .Cam:Battle 0` 5` *Fixed[3.0] )
		Call ShakeCam ( .Cam:Battle 0` 10` *Fixed[4.5] )
		Call ShakeCam ( .Cam:Battle 0` 5` *Fixed[3.0] )
	EndThread
	Call GetPartPos ( .Actor:Self .SuperFlyPart:BigShot *Var0 *Var1 *Var2 )
	Add *Var2 2`
	Call PlayEffect ( ~FX:SmokeRing:Blast1 *Var0 *Var1 *Var2 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 )
	Add *Var1 20`
	Add *Var2 2`
	Call PlayEffect ( ~FX:Explosion1 *Var0 *Var1 *Var2 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 )
	Call PlaySoundAtActor ( .Actor:Self .Sound:BombBlast )
	Wait 2`
	Thread
		Call GetPartPos ( .Actor:Self .SuperFlyPart:BigShot *Var0 *Var1 *Var2 )
		Add *Var2 2`
		Call SetPartPos ( .Actor:Self .SuperFlyPart:QuadShot1 *Var0 *Var1 *Var2 )
		Call SetAnimation ( .Actor:Self .SuperFlyPart:QuadShot1 .Anim:SmallFly_Idle )
		Call SetPartPos ( .Actor:Self .SuperFlyPart:QuadShot2 *Var0 *Var1 *Var2 )
		Call SetAnimation ( .Actor:Self .SuperFlyPart:QuadShot2 .Anim:SmallFly_Idle )
		Call SetPartPos ( .Actor:Self .SuperFlyPart:QuadShot3 *Var0 *Var1 *Var2 )
		Call SetAnimation ( .Actor:Self .SuperFlyPart:QuadShot3 .Anim:SmallFly_Idle )
		Call SetPartPos ( .Actor:Self .SuperFlyPart:QuadShot4 *Var0 *Var1 *Var2 )
		Call SetAnimation ( .Actor:Self .SuperFlyPart:QuadShot4 .Anim:SmallFly_Idle )
	EndThread
	Call EnemyDamageTarget ( .Actor:Self *Var0 ~Flags:DamageType:NoContact 0000FFFF 00000000 .SuperFlyDamage:QuadShot 00000020 )
	Call SetPartFlagBits ( .Actor:Self .SuperFlyPart:BigShot 00000001 .True )
	Call SetPartFlagBits ( .Actor:Self .SuperFlyPart:QuadShot1 00000001 .False )
	Call SetPartFlagBits ( .Actor:Self .SuperFlyPart:QuadShot2 00000001 .False )
	Call SetPartFlagBits ( .Actor:Self .SuperFlyPart:QuadShot3 00000001 .False )
	Call SetPartFlagBits ( .Actor:Self .SuperFlyPart:QuadShot4 00000001 .False )
	Wait 1`
	Thread
		Call GetPartPos ( .Actor:Self .SuperFlyPart:BigShot *Var0 *Var1 *Var2 )
		Call SetPartPos (.Actor:Self .SuperFlyPart:QuadShot1 *Var0 *Var1 *Var2 )
		% Add *Var0 300`
		Add *Var1 300`
		Add *Var2 2`
		Call SetPartMoveSpeed ( .Actor:Self .SuperFlyPart:QuadShot1 *Fixed[6.0] )
		Call FlyPartTo ( .Actor:Self .SuperFlyPart:QuadShot1 *Var0 *Var1 *Var2 0` 0` .Easing:Linear )
	EndThread
	Thread
		Call GetPartPos ( .Actor:Self .SuperFlyPart:BigShot *Var0 *Var1 *Var2 )
		Call SetPartPos (.Actor:Self .SuperFlyPart:QuadShot2 *Var0 *Var1 *Var2 )
		% Add *Var0 -300`
		Add *Var1 -300`
		Add *Var2 2`
		Call SetPartMoveSpeed ( .Actor:Self .SuperFlyPart:QuadShot2 *Fixed[6.0] )
		Call FlyPartTo ( .Actor:Self .SuperFlyPart:QuadShot2 *Var0 *Var1 *Var2 0` 0` .Easing:Linear )
	EndThread
	Thread
		Call GetPartPos ( .Actor:Self .SuperFlyPart:BigShot *Var0 *Var1 *Var2 )
		Call SetPartPos (.Actor:Self .SuperFlyPart:QuadShot3 *Var0 *Var1 *Var2 )
		Add *Var0 300`
		% Add *Var1 -300`
		Add *Var2 2`
		Call SetPartMoveSpeed ( .Actor:Self .SuperFlyPart:QuadShot3 *Fixed[6.0] )
		Call FlyPartTo ( .Actor:Self .SuperFlyPart:QuadShot3 *Var0 *Var1 *Var2 0` 0` .Easing:Linear )
	EndThread
	Thread
		Call GetPartPos ( .Actor:Self .SuperFlyPart:BigShot *Var0 *Var1 *Var2 )
		Call SetPartPos (.Actor:Self .SuperFlyPart:QuadShot4 *Var0 *Var1 *Var2 )
		Add *Var0 -300`
		% Add *Var1 -300`
		Add *Var2 2`
		Call SetPartMoveSpeed ( .Actor:Self .SuperFlyPart:QuadShot4 *Fixed[6.0] )
		Call FlyPartTo ( .Actor:Self .SuperFlyPart:QuadShot4 *Var0 *Var1 *Var2 0` 0` .Easing:Linear )
	EndThread
	Wait 60`
	Label ReturnHome
	Call SetPartFlagBits ( .Actor:Self .SuperFlyPart:QuadShot1 00000001 .True )
	Call SetPartFlagBits ( .Actor:Self .SuperFlyPart:QuadShot2 00000001 .True )
	Call SetPartFlagBits ( .Actor:Self .SuperFlyPart:QuadShot3 00000001 .True )
	Call SetPartFlagBits ( .Actor:Self .SuperFlyPart:QuadShot4 00000001 .True )
	Call YieldTurn ()
	SetConst *Var0 .SuperFlyPart:Main
	SetConst *Var1 .Anim:SuperFly_Attack
	Set *Var2 FFFFCFC7
	ExecWait DoDeath
	Call UseBattleCamPreset ( 00000002 ) % BTL_CAM_DEFAULT
	Call MoveBattleCamOver ( 24` )
	Wait 24`
	Return
	End
}