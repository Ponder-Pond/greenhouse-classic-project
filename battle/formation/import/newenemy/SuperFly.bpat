.Status:Normal		.Anim:SuperFly_Attack
.Status:Stone	    .Anim:SuperFly_Attack
.Status:Sleep	    .Anim:SuperFly_Attack
.Status:Poison	    .Anim:SuperFly_Attack
.Status:Stop	    .Anim:SuperFly_Attack
.Status:Static	    .Anim:SuperFly_Attack
